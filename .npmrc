# Lifecycle scripts do not run on install, so a compromised dependency cannot
# execute code at install time. The build output is not committed, so a git
# install needs scripts enabled - `prepare` compiles dist. The registry tarball
# ships the compiled output and needs nothing.
ignore-scripts=true

# Versions written to package.json are exact, as in sasjs/cli.
save-exact=true

# The engines field is a contract rather than a suggestion.
engine-strict=true

# Nothing here wants funding messages or a lockfile that drifts from the
# manifest.
fund=false
package-lock=true
