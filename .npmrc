# Lifecycle scripts do not run on install, so a compromised dependency cannot
# execute code at install time. This repo commits its build output, so nothing
# has to be compiled on install either - which is also what lets a consumer that
# sets ignore-scripts=true, such as sasjs/server, take it from git.
ignore-scripts=true

# Versions written to package.json are exact, as in sasjs/cli.
save-exact=true

# The engines field is a contract rather than a suggestion.
engine-strict=true

# Nothing here wants funding messages or a lockfile that drifts from the
# manifest.
fund=false
package-lock=true
