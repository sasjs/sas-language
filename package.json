{
  "name": "@sasjs/sas-language",
  "version": "0.1.0",
  "description": "SAS language data for editors: completions, hover documentation and signatures resolved from the SAS extension for VS Code, plus SAS log parsing",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./groups": {
      "types": "./dist/groups.generated.d.ts",
      "default": "./dist/groups.generated.js"
    },
    "./logs": {
      "types": "./dist/logs.d.ts",
      "default": "./dist/logs.js"
    },
    "./format": {
      "browser": {
        "types": "./dist/format.browser.d.ts",
        "default": "./dist/format.browser.bundle.js"
      },
      "types": "./dist/format.d.ts",
      "default": "./dist/format.bundle.js"
    },
    "./data/*": "./data/*",
    "./snippets/functions.json": "./snippets/functions.json",
    "./snippets/LICENSE.txt": "./snippets/LICENSE.txt",
    "./snippets/README.md": "./snippets/README.md",
    "./server/browser": "./server/browser/server.js",
    "./server/node": "./server/node/dist/node/server.js",
    "./provenance.json": "./provenance.json"
  },
  "files": [
    "dist",
    "data",
    "snippets",
    "server",
    "NOTICE",
    "provenance.json",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@sasjs/utils": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/sas-language.git"
  },
  "scripts": {
    "fetch": "node ./scripts/fetch-upstream.mjs",
    "build:data": "node ./scripts/build.mjs",
    "build:ts": "tsc -p ./tsconfig.json",
    "build:server": "node ./scripts/build-server.mjs",
    "build": "npm run build:data && npm run build:ts",
    "refresh": "npm run fetch && npm run build:data",
    "prepare": "npm run build:ts && (git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath ./.git-hooks || true)",
    "prepack": "npm run build:ship && npm run verify:pack",
    "test": "npm run build:ts && node --test ./test/*.test.mjs",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "release": "sasjs-release",
    "build:format": "node ./scripts/build-format.mjs && node ./scripts/build-format-browser.mjs",
    "build:format:node": "node ./scripts/build-format.mjs",
    "build:format:browser": "node ./scripts/build-format-browser.mjs",
    "build:ship": "npm run build && npm run build:server && npm run build:format",
    "verify:pack": "node ./scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@nogoo9/gitleaks": "8.30.1-post.2",
    "@sasjs/release": "0.4.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "sas",
    "language",
    "completions",
    "hover",
    "monaco"
  ]
}
