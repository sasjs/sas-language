{
  "name": "@sasjs/sas-language",
  "version": "0.1.0",
  "description": "SAS language data for editors: completions, hover documentation and signatures, resolved from the SAS extension for VS Code",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./groups": {
      "types": "./dist/groups.d.ts",
      "default": "./dist/groups.js"
    },
    "./data/*": "./data/*",
    "./provenance.json": "./provenance.json"
  },
  "files": [
    "dist",
    "data",
    "provenance.json",
    "README.md"
  ],
  "sideEffects": false,
  "overrides": {
    "ip-address": "^10.5.1",
    "undici": "^6.28.1"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/sas-language.git"
  },
  "scripts": {
    "fetch": "node ./scripts/fetch-upstream.mjs",
    "build:data": "node ./scripts/build.mjs",
    "build:ts": "tsc -p ./tsconfig.json",
    "build": "npm run build:data && npm run build:ts",
    "refresh": "npm run fetch && npm run build:data",
    "audit": "node ./scripts/audit.mjs",
    "prepare": "npm run build:ts && (git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath ./.git-hooks || true)",
    "prepack": "npm run build:ts",
    "test": "npm run build:ts && node --test ./test/*.test.mjs",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write ."
  },
  "devDependencies": {
    "@nogoo9/gitleaks": "8.30.1-post.2",
    "@semantic-release/exec": "7.1.0",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sas",
    "language",
    "completions",
    "hover",
    "monaco"
  ]
}
